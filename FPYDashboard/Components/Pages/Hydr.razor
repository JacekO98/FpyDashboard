@page "/Hydr"
@using FPY.CoreBussines
@inject IGetHydrResultsWeeklyFpyUseCase GetWeeklyFPY
@inject IGetHydrResultsMonthlyFpyUseCase GetMonthlyFPY

<FpyDashboard Title="Hydr" WeeklyResults="_weeklyResults" MonthlyResults="_monthlyResults" />

@code {
    private List<WeeklyFpy>? _weeklyResults;
    private List<MonthlyFpy>? _monthlyResults;

    protected override async Task OnInitializedAsync()
    {
        _weeklyResults = await GetWeeklyFPY.ExecuteAsync();
        _monthlyResults = await GetMonthlyFPY.ExecuteAsync();
    }
}
