@page "/"
@page "/HydrBV"
@using FPY.CoreBussines
@inject IGetHydrBVResultsWeeklyFpyUseCase GetWeeklyFPY
@inject IGetHydrBVResultsMonthlyFpyUseCase GetMonthlyFPY

<FpyDashboard Title="HydrBV" WeeklyResults="_weeklyResults" MonthlyResults="_monthlyResults" />

@code {
    private List<WeeklyFpy>? _weeklyResults;
    private List<MonthlyFpy>? _monthlyResults;

    protected override async Task OnInitializedAsync()
    {
        _weeklyResults = await GetWeeklyFPY.ExecuteAsync();
        _monthlyResults = await GetMonthlyFPY.ExecuteAsync();
    }
}
